# Ward's mock demo and unit tests require no credentials.

# NEAR testnet vault. See "Verify on NEAR testnet" in README.md.
# Public account ID of your funded named .testnet sponsor.
WARD_TESTNET_PARENT=
# Absolute path to the sponsor's private JSON file outside this repo. CLI deploy and browser testnet sponsorship.
WARD_TESTNET_SPONSOR_KEY=
# Unused absolute file path outside this repo. Deploy creates it, demo reads it.
WARD_TESTNET_KEYS=
# Optional SQLite path for USDC mode (npm run dev:testnet).
# WARD_TESTNET_USDC_DB=.ward/testnet-usdc-families.sqlite
# Optional SQLite path for the legacy native mode (npm run dev:testnet:near).
# WARD_TESTNET_WALLET_DB=.ward/testnet-families.sqlite

# Optional dry-run 1Click quote. Use separate development addresses.
WARD_QUOTE_RECIPIENT=
WARD_QUOTE_REFUND_TO=
WARD_QUOTE_USDC_ATOMIC=1000000
ONE_CLICK_JWT=

# Optional cloud screening. The default uses deterministic scoring only.
WARD_SCREENING=deterministic
NEAR_AI_API_KEY=

# Optional HTTPS reverse proxy for pairing across devices. Export before npm run dev.
WARD_WALLET_ORIGIN=
WARD_WALLET_HOST=127.0.0.1
